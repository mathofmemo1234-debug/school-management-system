rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read for schools, buildings, and classes for catalog navigation
    match /schools/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /school_buildings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /classes/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Secure all other documents: require authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

